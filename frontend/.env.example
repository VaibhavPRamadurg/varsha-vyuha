# Optional: enables the opt-in Satellite + 3D context style in MapLibre.
# Leave unset to run the reliable offline vector context only.
VITE_MAPTILER_KEY=your_api_key_here

# Required for a deployed frontend: the complete HTTPS URL of the FastAPI API.
# Local development defaults to http://127.0.0.1:8000 when omitted.
VITE_API_BASE_URL=https://your-api-host.example.com
